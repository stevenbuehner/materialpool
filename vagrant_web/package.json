{
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "npm run development",
    "development": "php artisan lang:js -c --no-lib; cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack-dev-server --hot --mode=development --config=webpack.config.js",
    "watch": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack --watch --progress --hide-modules --config=webpack.config.js",
    "watch-poll": "npm run watch -- --watch-poll",
    "hot": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development webpack-dev-server --inline --hot --config=webpack.config.js",
    "analyze": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=development ANALYZE=true webpack --config=webpack.config.js",
    "inventory:frontend": "node scripts/frontend-inventory.mjs",
    "lint": "eslint resources/js scripts tests/js *.config.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "prod": "npm run production",
    "production": "npm run build",
    "build": "php artisan lang:js -c --no-lib; cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --progress --hide-modules --mode=production --config=webpack.config.js"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@hokify/vuejs-datepicker": "^2.0.2",
    "@primer/octicons": "^9.6.0",
    "@videojs/themes": "^1.0.1",
    "@vue/compat": "3.5.42",
    "axios": "^0.21.4",
    "babel": "^6.23.0",
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "dayjs": "^1.11.23",
    "dompurify": "^2.5.9",
    "epic-spinners": "2.0.0",
    "is-url": "^1.2.4",
    "lang.js": "1.1.14",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "moment": "^2.30.1",
    "p-queue": "^7.4.1",
    "popper.js": "^1.16.0",
    "sass": "^1.104.0",
    "striptags": "^3.2.0",
    "tether": "^1.4.7",
    "video.js": "^7.21.7",
    "vue": "3.5.42",
    "vue-async-computed": "4.0.1",
    "vue-router": "4.6.4",
    "vue-select": "^3.20.4",
    "vue-star-rating": "^1.7.0",
    "vue-transmit": "9.0.0-alpha.11",
    "vuex": "4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-function-sent": "^7.29.7",
    "@babel/plugin-proposal-json-strings": "^7.18.6",
    "@babel/plugin-proposal-numeric-separator": "^7.18.6",
    "@babel/plugin-proposal-throw-expressions": "^7.29.7",
    "@babel/plugin-syntax-dynamic-import": "^7.7.4",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.29.7",
    "@babel/plugin-transform-optional-chaining": "7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vue/compiler-sfc": "3.5.42",
    "babel-helper-vue-jsx-merge-props": "^2.0.3",
    "babel-loader": "^8.4.1",
    "cross-env": "^7.0.3",
    "css-loader": "^3.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "file-loader": "^5.1.0",
    "globals": "^17.12.0",
    "mini-css-extract-plugin": "^0.9.0",
    "sass-loader": "^7.3.1",
    "style-loader": "^0.23.1",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "10.4.1",
    "vue-loader": "17.4.2",
    "webpack": "^4.47.0",
    "webpack-bundle-analyzer": "^3.9.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  }
}
