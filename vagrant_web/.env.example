APP_NAME=Materialpool
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost
LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

# Context search remains disabled until semantic search integration is approved.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=local-qdrant-development-key
FORWARD_QDRANT_PORT=6333
QDRANT_MEMORY_LIMIT=1536m
QDRANT_CPUS=1.0
QDRANT_CONNECT_TIMEOUT=2
QDRANT_TIMEOUT=10
QDRANT_COLLECTION_PREFIX=materialpool_chunks
QDRANT_ACTIVE_ALIAS=materialpool_chunks_active
QDRANT_DISTANCE=Cosine
QDRANT_VECTORS_ON_DISK=true
QDRANT_PAYLOAD_ON_DISK=true
CONTEXT_SEARCH_ENABLED=false
# Format: name=http(s)://host:11434|max_parallel_jobs[,next=http(s)://host:11434|max_parallel_jobs]
CONTEXT_SEARCH_OLLAMA_SERVERS="primary=http://host.docker.internal:11434|1"
# Optional, matching server names: primary=secret,secondary=other-secret
CONTEXT_SEARCH_OLLAMA_API_KEYS=
CONTEXT_SEARCH_OLLAMA_CONNECT_TIMEOUT=2
CONTEXT_SEARCH_OLLAMA_FAILURE_THRESHOLD=2
CONTEXT_SEARCH_OLLAMA_CIRCUIT_COOLDOWN=60
CONTEXT_SEARCH_EMBEDDING_MODEL=embeddinggemma:300m-qat-q8_0
# Set this to the exact SHA-256 digest returned by /api/tags on every Ollama server.
CONTEXT_SEARCH_EMBEDDING_DIGEST=
CONTEXT_SEARCH_EMBEDDING_DIMENSIONS=768
CONTEXT_SEARCH_EMBEDDING_TIMEOUT=30
CONTEXT_SEARCH_EMBEDDING_OPTIONS_JSON={}
CONTEXT_SEARCH_CHUNK_TARGET_CHARACTERS=1400
CONTEXT_SEARCH_CHUNK_OVERLAP_CHARACTERS=200
# Stage 1 uses this queue only after an explicit context-search:index command.
CONTEXT_SEARCH_INDEXING_QUEUE=context-search-indexing
CONTEXT_SEARCH_EMBEDDING_BATCH_SIZE=8
CONTEXT_SEARCH_PDF_NATIVE_TEXT_MINIMUM_CHARACTERS=80
CONTEXT_SEARCH_OCR_LANGUAGES=deu+eng
CONTEXT_SEARCH_OCR_TIMEOUT=120
# Used by Laravel AI SDK outside the context-search Ollama pool.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_API_KEY=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
QUEUE_RETRY_AFTER=150

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=materialpool@example.invalid
MAIL_FROM_NAME=Materialpool

TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=false

BACKUP_PATH=
BACKUP_TEMPORARY_DIRECTORY=
BACKUP_NOTIFICATION_EMAIL=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_URL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=materialpool
BACKUP_S3_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
