{
  "name": "stevenbuehner/materialpool",
  "description": "Materialpool",
  "keywords": [
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "repositories": [
    {
      "type": "github",
      "url": "https://github.com/stevenbuehner/PHPExiftool"
    }
  ],
  "require": {
    "php": "^7.1.3",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "howtomakeaturn/pdfinfo": "^1.1",
    "intervention/image": "^2.3",
    "kalnoy/nestedset": "^5.0",
    "laracasts/utilities": "^3.0",
    "laravel/framework": "^8.0",
    "laravel/passport": "^10.0",
    "laravel/tinker": "^2.0",
    "laravel/ui": "^3.0",
    "miljar/php-exif": "^0.6.5",
    "nanigans/single-table-inheritance": "^1.0",
    "ncjoes/office-converter": "^1.0",
    "php-ffmpeg/php-ffmpeg": "^0.18",
    "phpexiftool/exiftool": "^10.16",
    "setasign/fpdi-fpdf": "^2.0",
    "spatie/laravel-backup": "^6.0",
    "spatie/pdf-to-text": "^1.1",
    "stevenbuehner/bible-verse-bundle": "dev-develop"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.2",
    "barryvdh/laravel-ide-helper": "^2.8",
    "filp/whoops": "^2.0",
    "mockery/mockery": "^1.0",
    "nunomaduro/collision": "^5.0",
    "phpunit/phpunit": "^9.0",
    "facade/ignition" : "^2.3.6"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories",
      "Database\\Seeders\\": "database/seeders"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate"
    ]
  }
}
