{
  "name": "laravel/laravel",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": ">=5.6.4",
    "alchemy/phpexiftool": "^0.6.0",
    "backpack/base": "^0.7.16",
    "backpack/crud": "^3.2",
    "intervention/image": "^2.3",
    "kalnoy/nestedset": "^4.2",
    "laravel/framework": "5.4.*",
    "laravel/passport": "^2.0",
    "laravel/tinker": "~1.0",
    "laravelcollective/html": "^5.4",
    "nanigans/single-table-inheritance": "^0.7.1",
    "nwidart/laravel-modules": "^1.20",
    "php-ffmpeg/php-ffmpeg": "^0.9.3",
    "spatie/laravel-responsecache": "^3.2",
    "stevenbuehner/bible-verse-bundle": "^2.0"
  },
  "require-dev": {
    "backpack/generators": "^1.1",
    "barryvdh/laravel-debugbar": "^2.3",
    "barryvdh/laravel-ide-helper": "^2.3",
    "fzaninotto/faker": "~1.4",
    "mockery/mockery": "0.9.*",
    "phpunit/phpunit": "~5.7"
  },
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/",
      "Modules\\": "Modules/",
      "StevenBuehner\\PdfPreview\\": "packages/stevenbuehner/pdfpreview/src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "php artisan key:generate"
    ],
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "php artisan optimize"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true
  }
}
