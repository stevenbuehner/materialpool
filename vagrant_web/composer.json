{
  "name": "laravel/laravel",
  "description": "The Laravel Framework.",
  "keywords": [
    "framework",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": ">=7.1",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "alchemy/phpexiftool": "^0.6.0",
    "intervention/image": "^2.3",
    "kalnoy/nestedset": "^4.2",
    "laracasts/utilities": "^3.0",
    "laravel/framework": "5.5.*",
    "laravel/passport": "~4.0",
    "laravel/tinker": "~1.0",
    "laravelcollective/html": "~5.4",
    "martinlindhe/laravel-vue-i18n-generator": "^0.1.35",
    "nanigans/single-table-inheritance": "~0.8",
    "php-ffmpeg/php-ffmpeg": "~0.9.3",
    "setasign/fpdi-fpdf": "^2.0",
    "spatie/laravel-backup": "^5.0",
    "spatie/pdf-to-text": "^1.1",
    "stevenbuehner/bible-verse-bundle": "^2.4"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.2",
    "barryvdh/laravel-ide-helper": "^2.3",
    "filp/whoops": "~2.0",
    "fzaninotto/faker": "~1.4",
    "mockery/mockery": "0.9.*",
    "phpunit/phpunit": "~6.0"
  },
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "php artisan key:generate"
    ],
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall",
      "php artisan optimize"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate",
      "php artisan optimize"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
    ]
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
