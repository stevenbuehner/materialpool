{
  "name": "stevenbuehner/materialpool",
  "description": "Materialpool",
  "keywords": [
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "repositories": [
    {
      "type": "github",
      "url": "https://github.com/stevenbuehner/PHPExiftool"
    }
  ],
  "require": {
    "php": "^7.1.3",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "alchemy/phpexiftool": "dev-develop",
    "doctrine/dbal": "^2.9",
    "howtomakeaturn/pdfinfo": "^1.1",
    "intervention/image": "^2.3",
    "kalnoy/nestedset": "^4.3",
    "laracasts/utilities": "^3.0",
    "laravel/framework": "5.7.*",
    "laravel/passport": "^7.0",
    "laravel/tinker": "^1.0",
    "martinlindhe/laravel-vue-i18n-generator": "^0.1.35",
    "nanigans/single-table-inheritance": "~0.8",
    "ncjoes/office-converter": "^1.0",
    "php-ffmpeg/php-ffmpeg": "^0.13",
    "setasign/fpdi-fpdf": "^2.0",
    "spatie/laravel-backup": "^6.0",
    "spatie/pdf-to-text": "^1.1",
    "stevenbuehner/bible-verse-bundle": "^2.5"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.2",
    "barryvdh/laravel-ide-helper": "^2.3",
    "beyondcode/laravel-dump-server": "^1.0",
    "filp/whoops": "^2.0",
    "fzaninotto/faker": "^1.4",
    "mockery/mockery": "^1.0",
    "nunomaduro/collision": "^2.0",
    "phpunit/phpunit": "^7.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "autoload": {
    "classmap": [
      "database"
    ],
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ],
    "post-install-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postInstall"
    ],
    "post-update-cmd": [
      "Illuminate\\Foundation\\ComposerScripts::postUpdate"
    ]
  }
}
