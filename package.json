{
  "name": "materialpool-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "php artisan lang:js --json && vite",
    "development": "npm run dev",
    "watch": "npm run dev",
    "watch-poll": "npm run dev",
    "hot": "npm run dev",
    "inventory:frontend": "node scripts/frontend-inventory.mjs",
    "inventory:dependencies": "npm sbom --sbom-format cyclonedx",
    "check:bundle": "node scripts/check-frontend-bundle.mjs",
    "docs:check": "node scripts/check-readme.mjs",
    "docs:screenshots": "npm run build && MATERIALPOOL_README_SCREENSHOTS=1 playwright test tests/browser/login.spec.js tests/browser/compat-app.spec.js tests/browser/readme-screenshots.spec.js",
    "lint": "eslint resources/js scripts tests/js tests/browser *.config.mjs --max-warnings=0",
    "test:ci": "npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "prod": "npm run production",
    "production": "npm run build",
    "build": "php artisan lang:js --json && vite build && npm run check:bundle"
  },
  "dependencies": {
    "@primer/octicons": "^9.6.0",
    "@vueform/multiselect": "2.6.11",
    "@vuepic/vue-datepicker": "14.0.0",
    "axios": "^1.20.0",
    "bootstrap": "5.3.8",
    "bootstrap-vue-next": "1.1.0",
    "date-fns": "4.4.0",
    "dayjs": "1.11.23",
    "dompurify": "^3.4.15",
    "epic-spinners": "2.0.0",
    "is-url": "^1.2.4",
    "lang.js": "1.1.14",
    "lodash": "^4.18.1",
    "marked": "^4.3.0",
    "p-queue": "^7.4.1",
    "pinia": "4.0.3",
    "sass": "^1.104.0",
    "striptags": "^3.2.0",
    "tether": "^1.4.7",
    "video.js": "^8.24.0",
    "vue": "3.5.42",
    "vue-async-computed": "4.0.1",
    "vue-json-pretty": "2.6.0",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.42",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "laravel-vite-plugin": "3.2.0",
    "vite": "8.3.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "10.4.1"
  }
}
